# TDX — Environment Variable Template (PLACEHOLDERS ONLY — never put real values here)
#
# Only variables actually referenced by the codebase are listed.
# Secrets belong in web/.env.local (gitignored) or the Vercel dashboard.

# ---- Supabase (public-safe, browser-visible; protected by RLS) ----
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# ---- Supabase (SERVER-ONLY — bypasses RLS, never expose to the browser) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Gemini AI (SERVER-ONLY — used by /api/chat and /api/deposit) ----
GEMINI_API_KEY=your-gemini-key

# ---- Web Push (private key is SERVER-ONLY; public key is browser-safe) ----
VAPID_PRIVATE_KEY=your-vapid-private-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# ---- SMTP (SERVER-ONLY — notification emails) ----
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# ---- Ops (SERVER-ONLY) ----
# Bearer secret required by /api/cron/* routes.
CRON_SECRET=your-cron-secret
# Recipient address for admin notification emails (has a hardcoded fallback in code).
ADMIN_EMAIL=admin@example.com
